# Craft: filmmaking rules that hold for any film. Always on. A film replaces a rule by declaring its id again, replaces a limit by declaring its name again, and turns a rule off with `off <id>`.
# Limits marked "set on one film" were set on a single approved film so that it reads clean. They are defaults. They are not validated on other films.
limit jitter.reversals 4 note="set on one film"
limit jitter.amp_px 0.5 note="set on one film"
limit jitter.window_frames 15 note="set on one film"
limit jitter.runs 3 note="set on one film"
limit spike.px 30 note="set on one film"
limit cover.share 0.2 note="set on one film"
limit cover.frames 15 note="set on one film"
limit silence.seconds 1 note="set on one film"
limit sync.over0_db 3 note="set on one film"
limit bed.peak 1.5 note="set on one film"
limit alike.delta 18 note="set on one film"
limit snap.px 10 note="set on one film"
limit snap.even_px 1.5 note="set on one film"

rule craft.words_cut where verb=scene expect words_cut<=9 say="Text elements are at least {cover.share%} covered by a later opaque shape for {cover.frames} frames or more" note="set on one film"
rule craft.jitter where verb=scene expect jitter_elements<=0 say="Elements keep reversing direction with no event near" note="set on one film"
rule craft.spike where verb=scene expect spikes<=0 say="Elements leave their path for 1 to 2 frames and come back, with no event near" note="set on one film"
rule craft.snap where verb=scene expect group_snap<=5 say="A group of elements jumps off a steady path on one frame, with no event near" note="set on seven films: a wall that jumped read 48, its fix 0, the others 2 or less"
rule craft.flow where verb=scene expect flow_jitter<=39 say="Picture flow reverses at least 6 times a second, counted in cell-seconds" note="set on one film"
rule craft.clipping where verb=film expect clip_samples<=200 say="Samples at full scale" note="set on one film"
rule craft.silence where verb=film expect silence_s<=0 say="Stretches below -55 dBFS" note="set on one film"
rule craft.sync where verb=film expect cue_lag_frames<=1.99 say="Event sounds land off their score cues" note="set on one film"
rule craft.bed where verb=film expect bed_off_ms<=60 say="The bed's low-band beat sits off the film's beat grid" note="set on one film"

rule craft.contrast where drawn.boxed=1 expect drawn.contrast>=3 say="Text on its own filled box needs a contrast of 3 to 1 or more" note="the WCAG floor for large text"
rule craft.read where words>=1 expect read_ratio>=0.75 say="A line stays legible for less than three quarters of its reference reading time" note="set on one film"
rule craft.clip where words>=1 expect clip_frames<=9 say="Text is cut by a clip for 10 frames or more" note="set on one film"
