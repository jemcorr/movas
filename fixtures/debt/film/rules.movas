rule read.punch per_word=0.17 base=0.85 owner=fixture why="reading time for a headline"
rule read.dock per_word=0.17 base=1.7 owner=fixture why="reading time for a caption"
rule min.text px=30 owner=fixture type=defect why="legible on a 720p screen"
rule tone.threat words=lawsuit,police scope=verb:text say="a reminder may not threaten" owner=fixture why="the product reminds, it does not threaten"
style punch in=7f snap=0.25b
style dock line=8f stagger=3f dock=10f
